# Copy the same values from .env.local when using Cloudflare preview.
DATABASE_URL="postgresql://aurbit:aurbit@localhost:5433/aurbit?schema=public"
PUBLIC_APP_URL="http://localhost:8787"

# Required for public report abuse protection. The site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare preview uses the HTTP-compatible Upstash backend.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
