# Authenticated admin application and database.
DATABASE_URL="postgresql://aurbit:aurbit@localhost:5433/aurbit?schema=public"
NEXT_PUBLIC_APP_ENV=local

# Generate a unique value with: pnpm --filter admin exec auth secret
AUTH_SECRET=
AUTH_URL="http://localhost:3001"

# Google OAuth callbacks:
# Local: http://localhost:3001/api/auth/callback/google
# Production: https://admin.aurbit.takshil.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic links, email verification, password reset, and invitations.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# Authentication abuse protection. The site key is browser-visible.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local rate limiting uses Docker Redis. Staging/production use Upstash REST.
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel staging/production: private R2 S3-compatible credentials.
# Leave blank locally; both Next apps share .aurbit/storage in local development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Vercel staging/production: publish to the matching Cloudflare Queue over HTTPS.
# Leave blank locally; the producer defaults to the local Worker on port 8787.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_ID=
CLOUDFLARE_QUEUE_API_TOKEN=
AURBIT_LOCAL_QUEUE_URL=

# Workspace webhook encryption key; use the same value in the matching Worker.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_LOCAL_TESTING=false

# Observability is optional locally. The browser DSN is not an account secret.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
BETTER_STACK_INGESTING_HOST=
BETTER_STACK_SOURCE_TOKEN=
