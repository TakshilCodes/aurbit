{
  "name": "@aurbit/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#prisma-client": {
      "workerd": "./src/generated/prisma-cloudflare/client.ts",
      "default": "./src/generated/prisma/client.ts"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:validate": "prisma validate",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "devDependencies": {
    "@aurbit/eslint-config": "workspace:*",
    "@aurbit/typescript-config": "workspace:*",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "prisma": "^7.9.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
