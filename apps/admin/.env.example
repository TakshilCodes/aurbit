# Local database used by the admin application.
DATABASE_URL="postgresql://aurbit:aurbit@localhost:5433/aurbit?schema=public"

# Observability is optional locally. Public DSN identifies the Sentry project, not an account secret.
# Set the app environment at build time: local, staging, or production.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SENTRY_DSN=
# Optional BUILD-ONLY source-map uploads; never expose SENTRY_AUTH_TOKEN to the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional server-only HTTPS log export. Leave both blank for stdout-only logging.
# Copy the ingestion host and SOURCE token from a Better Stack HTTP source.
BETTER_STACK_INGESTING_HOST=
BETTER_STACK_SOURCE_TOKEN=

# Generate a unique value with: pnpm --filter admin exec auth secret
AUTH_SECRET=
AUTH_URL="http://localhost:3001"

# Google OAuth callback: http://localhost:3001/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required for magic links, email verification, and password reset.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# Required for authentication abuse protection. The site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local rate limiting uses the existing Docker Redis service.
REDIS_URL="redis://localhost:6379"

# Staging/production rate limiting uses Upstash REST instead of REDIS_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Workspace webhook secrets: same 32-byte base64 key as the background Worker.
WEBHOOK_ENCRYPTION_KEY=
# Development only; allows the local webhook receiver on loopback port 8789.
WEBHOOK_LOCAL_TESTING=false
