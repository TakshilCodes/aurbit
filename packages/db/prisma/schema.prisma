generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BugReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String?
  emailVerified        DateTime?            @map("email_verified")
  image                String?
  passwordHash         String?              @map("password_hash")
  sessionVersion       Int                  @default(0) @map("session_version")
  activeOrganizationId String?              @map("active_organization_id")
  activeOrganization   Organization?        @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  accounts             Account[]
  authTokens           AuthToken[]
  memberships          OrganizationMember[]
  internalNotes        InternalNote[]
  auditEntries         AuditLog[]
  workspaceInvitesSent OrganizationInvite[] @relation("WorkspaceInviteInviter")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([activeOrganizationId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("auth_tokens")
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  activeUsers User[]               @relation("ActiveOrganization")
  memberships OrganizationMember[]
  projects    Project[]
  auditLogs   AuditLog[]
  invites     OrganizationInvite[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("organizations")
}

model OrganizationMember {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  userId          String           @map("user_id")
  role            OrganizationRole
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedReports BugReport[]      @relation("BugReportAssignee")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationInvite {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  email           String           @db.VarChar(254)
  role            OrganizationRole
  tokenHash       String           @unique @map("token_hash") @db.VarChar(64)
  pendingKey      String?          @unique @map("pending_key") @db.VarChar(400)
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  revokedAt       DateTime?        @map("revoked_at")
  invitedByUserId String           @map("invited_by_user_id")
  lastSentAt      DateTime         @default(now()) @map("last_sent_at")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("WorkspaceInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@map("organization_invites")
}

model Project {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  publicKey      String       @unique @map("public_key")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bugReports     BugReport[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("projects")
}

model BugReport {
  id               String              @id @default(cuid())
  organizationId   String              @map("organization_id")
  projectId        String              @map("project_id")
  assigneeMemberId String?             @map("assignee_member_id")
  title            String              @db.VarChar(160)
  description      String              @db.Text
  reporterEmail    String?             @map("reporter_email") @db.VarChar(254)
  pageUrl          String?             @map("page_url") @db.VarChar(2048)
  userAgent        String?             @map("user_agent") @db.VarChar(512)
  viewportWidth    Int?                @map("viewport_width")
  viewportHeight   Int?                @map("viewport_height")
  status           BugReportStatus     @default(OPEN)
  priority         BugReportPriority   @default(MEDIUM)
  project          Project             @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee         OrganizationMember? @relation("BugReportAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  attachments      Attachment[]
  internalNotes    InternalNote[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@index([organizationId, projectId, createdAt])
  @@index([projectId, createdAt])
  @@index([assigneeMemberId])
  @@map("bug_reports")
}

model InternalNote {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  bugReportId    String    @map("bug_report_id")
  authorId       String    @map("author_id")
  body           String    @db.VarChar(4000)
  bugReport      BugReport @relation(fields: [bugReportId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "internal_notes_bug_report_id_fkey")
  author         User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, bugReportId, createdAt])
  @@index([authorId])
  @@map("internal_notes")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  actorUserId    String?      @map("actor_user_id")
  action         String       @db.VarChar(100)
  targetType     String       @map("target_type") @db.VarChar(64)
  targetId       String?      @map("target_id") @db.VarChar(100)
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt, id])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Attachment {
  id          String    @id @default(cuid())
  bugReportId String    @map("bug_report_id")
  storageKey  String    @unique @map("storage_key") @db.VarChar(255)
  fileName    String    @map("file_name") @db.VarChar(255)
  contentType String    @map("content_type") @db.VarChar(100)
  size        Int
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([bugReportId])
  @@map("attachments")
}
