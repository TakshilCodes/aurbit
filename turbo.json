{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ],
  "globalPassThroughEnv": [
    "BETTER_STACK_INGESTING_HOST",
    "BETTER_STACK_SOURCE_TOKEN",
    "AURBIT_ENV",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "WEBHOOK_ENCRYPTION_KEY",
    "WEBHOOK_LOCAL_TESTING",
    "WEBHOOK_TEST_SECRET",
    "AUTH_EMAIL_FROM",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "AUTH_RESEND_KEY",
    "AUTH_SECRET",
    "AUTH_URL",
    "PUBLIC_APP_URL",
    "DATABASE_URL",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "REDIS_URL",
    "TURNSTILE_SECRET_KEY",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "AURBIT_LOCAL_QUEUE_URL",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_QUEUE_API_TOKEN",
    "CLOUDFLARE_QUEUE_ID",
    "R2_ACCESS_KEY_ID",
    "R2_ACCOUNT_ID",
    "R2_BUCKET_NAME",
    "R2_SECRET_ACCESS_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
