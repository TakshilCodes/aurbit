{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aurbit-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "r2_buckets": [{ "binding": "BUG_REPORT_ATTACHMENTS" }],
  "services": [
    {
      "binding": "AURBIT_EVENTS_LOCAL",
      "service": "aurbit-worker",
      "entrypoint": "LocalQueueProducer",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "AURBIT_EVENTS", "queue": "aurbit-events-local" },
    ],
  },
  "env": {
    "staging": {
      "r2_buckets": [{ "binding": "BUG_REPORT_ATTACHMENTS" }],
      "queues": {
        "producers": [
          { "binding": "AURBIT_EVENTS", "queue": "aurbit-events-staging" },
        ],
      },
    },
    "production": {
      "r2_buckets": [{ "binding": "BUG_REPORT_ATTACHMENTS" }],
      "queues": {
        "producers": [
          { "binding": "AURBIT_EVENTS", "queue": "aurbit-events-production" },
        ],
      },
    },
  },
}
